{
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; base-uri 'self'; connect-src 'self' https://api.sociobot.in; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' blob:; manifest-src 'self'; object-src 'none'; script-src 'self'; style-src 'self'; worker-src 'self'",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Content-Type-Options": "nosniff",
    "Permissions-Policy": "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
  },
  "routes": [
    {
      "route": "/assets/*",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/sw.js",
      "headers": { "Cache-Control": "no-cache" }
    },
    {
      "route": "/manifest.webmanifest",
      "headers": { "Cache-Control": "no-cache" }
    }
  ],
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/sw.js", "/manifest.webmanifest", "/offline.html", "/offline.css", "/404.html", "/404.css", "/robots.txt", "/sitemap.xml"]
  },
  "responseOverrides": {
    "404": { "rewrite": "/404.html" }
  }
}
